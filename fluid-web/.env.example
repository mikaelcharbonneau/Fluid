# Copy to .env.local for local development.
#
# Phase 2 — auth + persistence (Supabase). These match the variables the
# Supabase↔Vercel integration provisions. Both are safe to expose to the
# browser (project URL + publishable key); row-level security protects data.
# Find them in the Supabase dashboard under Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects may use this name instead; the app accepts either:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phase 3 — real generation (server-side only, never expose to the browser):
#   OPENAI_API_KEY=
#   OPENAI_TEXT_MODEL=gpt-5.6-luna  # optional override for Responses API text calls

# Billing (Stripe) — all server-side secrets, never expose to the browser.
# Tokens meter generation; each plan is a recurring price that refills monthly.
#   STRIPE_SECRET_KEY=            # sk_live_... / sk_test_...
#   STRIPE_WEBHOOK_SECRET=        # whsec_... (from the webhook endpoint you create)
#   STRIPE_PRICE_STARTER=        # price_... (recurring price — Starter, 150 tokens/mo)
#   STRIPE_PRICE_PRO=             # price_... (recurring price — Pro, 500 tokens/mo)

# Real-time domain availability for the name-suggestions step (POST
# /api/domains/check), via Vercel's own Domains Registrar API — not a
# third-party service. Generate a token at vercel.com/account/tokens.
# Without it, name suggestions still work; the domain hint just shows
# without an availability badge.
#   VERCEL_ACCESS_TOKEN=
#   VERCEL_TEAM_ID=                # only needed if the token is team-scoped

# Secret for the reference auto-tagger (POST /api/logo-references/tag).
# Any signed-in user could otherwise rewrite the shared logo catalogue and burn
# model spend doing it, so the route requires this as well as a session.
#   LOGO_TAGGING_SECRET=

# Service-role key for webhook writes that have no user session (KEEP SECRET —
# it bypasses row-level security). Supabase dashboard → Project Settings → API.
#   SUPABASE_SERVICE_ROLE_KEY=

# Durable generation jobs. Vercel Cron sends this secret as the Authorization
# bearer token to the worker endpoint. Generate a long random value per env.
#   CRON_SECRET=
