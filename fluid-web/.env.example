# Copy to .env.local for local development.
#
# This file documents every environment variable the app reads — see
# src/lib/env/schema.ts for the validated schema this is generated to match
# (src/lib/env/env-example.test.ts fails CI if the two drift). Values are
# validated (format, allowed prefixes, minimum secret length) at import time
# by src/lib/env/{public,server}.ts; a required-in-production variable that's
# still missing fails server startup — see src/lib/env/startup.ts.

# --- Supabase (auth + persistence) -----------------------------------------
# These match the variables the Supabase↔Vercel integration provisions. Both
# are safe to expose to the browser (project URL + publishable key); row-level
# security protects data. Find them in the Supabase dashboard under
# Project Settings → API. Optional: the app has a working fallback for both.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects may use this name instead; the app accepts either:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Legacy unprefixed alias for the publishable key above (not a secret,
# despite the name — do not confuse with SUPABASE_SERVICE_ROLE_KEY below):
# SUPABASE_ANON_KEY=

# Service-role key for webhook writes that have no user session (KEEP SECRET —
# it bypasses row-level security). Supabase dashboard → Project Settings → API.
# Required in production.
#   SUPABASE_SERVICE_ROLE_KEY=

# --- AI generation (OpenAI) --------------------------------------------------
# Required in production — every generation feature depends on it.
#   OPENAI_API_KEY=
# All optional overrides below have working defaults; only set them for an
# experiment or to pin a preview to a specific prompt revision.
#   OPENAI_TEXT_MODEL=gpt-5.6-luna
#   OPENAI_IMAGE_MODEL=gpt-image-2
#   OPENAI_TRANSPARENT_IMAGE_MODEL=gpt-image-2
#   OPENAI_LETTERMARK_ANALYSIS_PROMPT_ID=
#   OPENAI_LETTERMARK_ANALYSIS_PROMPT_VERSION=

# Raster-to-vector export for the brand-kit asset pipeline. Optional — without
# it the feature responds with a clear "unavailable" error.
#   RECRAFT_API_KEY=

# --- Billing (Stripe) --------------------------------------------------------
# All server-side secrets, never exposed to the browser. Tokens meter
# generation; each plan is a recurring price that refills monthly. Required
# together in production.
#   STRIPE_SECRET_KEY=            # sk_live_... / sk_test_...
#   STRIPE_WEBHOOK_SECRET=        # whsec_... (from the webhook endpoint you create)
#   STRIPE_PRICE_STARTER=         # price_... (recurring price — Starter, 150 tokens/mo)
#   STRIPE_PRICE_PRO=             # price_... (recurring price — Pro, 500 tokens/mo)

# --- Domain availability (Vercel Registrar API) ------------------------------
# Real-time domain availability for the name-suggestions step (POST
# /api/domains/check) — Vercel's own registrar API, not a third-party
# service. Generate a token at vercel.com/account/tokens. Optional: without
# it, name suggestions still work; the domain hint just shows without an
# availability badge.
#   VERCEL_ACCESS_TOKEN=
#   VERCEL_TEAM_ID=                # only needed if the token is team-scoped

# --- Error monitoring (Sentry) -----------------------------------------------
# Everything below is optional — with none of it set, the app runs exactly
# as before, just without error reporting. See docs/error-monitoring.md for
# setup and triage.
#   SENTRY_DSN=                    # server + edge runtime
#   NEXT_PUBLIC_SENTRY_DSN=        # browser — same project, public DSN
#   SENTRY_ENVIRONMENT=            # optional override; defaults to VERCEL_ENV
#   NEXT_PUBLIC_SENTRY_ENVIRONMENT=
#   SENTRY_ORG=                    # for source-map upload at build time
#   SENTRY_PROJECT=
#   SENTRY_AUTH_TOKEN=             # scoped to source-map uploads only
# Vercel sets this automatically on every deploy; only set it by hand for a
# non-Vercel environment that wants a release identifier on client events.
#   NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=

# Bearer secret gating GET /api/internal/test-error (always 404s in
# production regardless of this value). Leave unset in preview if the
# preview URL isn't shared outside the team.
#   TEST_ERROR_SECRET=
